SiiNunit
{
#
#   10-speed close-ratio drag box with a torque converter. Original ladder.
#
#   Design targets
#     T1  Top gear geared for ~400 km/h at the power peak, so the truck is
#         limited by aerodynamic drag rather than by hitting the rev limiter.
#     T2  Close ratios: after every upshift the engine must still land inside
#         the 3000-4300 power band.
#     T3  A standing-start launch limited by traction, not by torque.
#
#   Derivation
#     rpm = km/h * 5.2397 * (final_drive * gear)      315/70 R22.5
#
#     T1: 2.64 * 0.72 = 1.9008
#         3900 rpm -> 392 km/h ; 5200 rpm limiter -> 522 km/h, so the
#         limiter is never the ceiling. Estimated drag-limited terminal
#         speed bobtail is ~410 km/h at ~4090 rpm, just past peak power.
#
#     T2: single geometric progression, 4.20 down to 0.72 over 10 gears
#         r = (4.20 / 0.72) ^ (1/9) = 1.21647
#         A shift drops rpm by that factor: 4300 / 1.216 = 3536, still in band.
#
#     T3: 10000 Nm * 2.20 converter * 4.20 * 2.64 / 0.50625 m = 481 kN.
#         On a bobtail tractor that is far past what the tyres hold, which is
#         the intended character. Traction is the limit, so a 6x4 chassis
#         launches much better than the 6x2 (one driven axle).
#
accessory_transmission_data : gb10_drag.scania.r_2016.transmission
{
	name: "10-speed Drag AMT 5000 (unofficial)"
	price: 120000
	unlock: 26
	icon: "transmission_scania_grs"
	part_type: factory

	# Torque converter multiplication at stall. Multiplies launch torque and
	# removes the dead spot a dry clutch has off the line.
	stall_torque_ratio: 2.20

	# Tall final drive. All of the top-speed reach comes from here.
	differential_ratio: 2.64

	# Dual-clutch quick. The factory Opticruise takes 0.7 s, which throws
	# away most of a standing-start run over ten shifts.
	shift_time: 0.10

	ratios_reverse[0]: -4.20

	ratios_forward[0]: 4.20         # limiter at  90 km/h
	ratios_forward[1]: 3.45         #            109
	ratios_forward[2]: 2.84         #            132
	ratios_forward[3]: 2.33         #            161
	ratios_forward[4]: 1.92         #            196
	ratios_forward[5]: 1.58         #            238
	ratios_forward[6]: 1.30         #            289
	ratios_forward[7]: 1.07         #            351
	ratios_forward[8]: 0.88         #            427
	ratios_forward[9]: 0.72         #            522 (drag-limited to ~410)

	# No crawler gears - nothing here is for manoeuvring.

	# Stopping from 400 km/h is the real problem this mod creates. Staging is
	# front-loaded rather than linear so the first position already does
	# meaningful work, with engine brake added on top at position 5.
	retarder: 5
	auxiliary_brakes[]: (0.30, 0.0, 0)
	auxiliary_brakes[]: (0.55, 0.0, 0)
	auxiliary_brakes[]: (0.75, 0.0, 0)
	auxiliary_brakes[]: (0.90, 0.0, 0)
	auxiliary_brakes[]: (1.0,  1.0, 0)

@include "sound.sui"
}
}
